<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="KAREER | Installed Office" Width="880" Height="760" MinWidth="760" MinHeight="650" WindowStartupLocation="CenterOwner" Background="#F3F5F9" FontFamily="Segoe UI" Foreground="#182338">
  <Grid Background="#F3F5F9"><Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,19"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Office on this PC" FontWeight="Bold" FontSize="27"/><TextBlock Text="Review what's installed. Remove Office when you're ready." Foreground="#67758A" FontSize="13" Margin="0,6,0,0"/></StackPanel><Button x:Name="RefreshOfficeButton" Grid.Column="1" Content="↻  Refresh" VerticalAlignment="Center"/></Grid>
    <Border Grid.Row="1" Background="#EAF7F3" BorderBrush="#C5E6DC" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,0,0,14"><StackPanel><TextBlock x:Name="InventoryHeading" Text="Checking installed Office…" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="InventoryNote" Text="Reading Windows installation records. No changes are made." FontSize="11" Foreground="#586E6A" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,14">
      <StackPanel><ItemsControl x:Name="InstalledOfficeList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#DFE5EE" BorderThickness="1" CornerRadius="9" Padding="15,12" Margin="0,0,0,9"><StackPanel><TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" Foreground="#147C71" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding Details}" Foreground="#67758A" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding ProductSummary}" Foreground="#8390A0" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="EmptyOfficeNote" Text="No registered Office installations were found." Foreground="#67758A" FontSize="13" Margin="5,16,5,16" TextWrapping="Wrap" Visibility="Collapsed"/></StackPanel>
    </ScrollViewer>
    <Border Grid.Row="3" Background="White" BorderBrush="#DFE5EE" BorderThickness="1" CornerRadius="12" Padding="18,16">
      <StackPanel>
        <TextBlock Text="REMOVE OFFICE" FontSize="10" FontWeight="Bold" Foreground="#9D4241" Margin="0,0,0,10"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><RadioButton x:Name="StandardRemoval" Content="Standard uninstall" GroupName="RemovalMode" IsChecked="True" FontWeight="SemiBold" FontSize="13"/><RadioButton x:Name="DeepRemoval" Grid.Column="1" Content="Deep cleanup · Microsoft tool" GroupName="RemovalMode" FontWeight="SemiBold" FontSize="13"/></Grid>
        <TextBlock x:Name="RemovalDescription" Text="Removes all detected Office products, including Project, Visio, and Office language packs." TextWrapping="Wrap" FontSize="11" Foreground="#58677B" Margin="0,9,0,0"/>
        <TextBlock Text="Personal documents and Outlook data files are kept. Standalone OneDrive, new Teams, and new Outlook are managed separately. Save your work and close Office apps first." TextWrapping="Wrap" FontSize="11" Foreground="#67758A" Margin="0,7,0,0"/>
        <CheckBox x:Name="RemovalConsent" Margin="0,13,0,12" FontSize="11"><TextBlock x:Name="RemovalConsentText" Text="I want to remove all Office products shown above, including any Project and Visio, and accept Microsoft's tool license terms." TextWrapping="Wrap"/></CheckBox>
        <ProgressBar x:Name="RemovalProgress" Height="5" BorderThickness="0" Background="#E9EEF3" Foreground="#AD4E47" Margin="0,0,0,8"/>
        <TextBlock x:Name="RemovalStatus" Text="Choose a removal method to begin." Foreground="#67758A" FontSize="11" TextWrapping="Wrap" MaxHeight="48" Margin="0,0,0,10"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="UninstallOfficeButton" Content="Uninstall Office" Background="#AD4E47" Foreground="White" IsEnabled="False" MinWidth="152"/><Button x:Name="CleanupToolTerms" Grid.Column="2" Content="Tool license" ToolTip="Download Microsoft's verified cleanup tool and display its license. Does not run cleanup." Background="Transparent" Foreground="#67758A" FontSize="11" Padding="9,9"/><Button x:Name="OfficeCleanupHelp" Grid.Column="3" Content="Microsoft help" Background="Transparent" Foreground="#67758A" FontSize="11" Padding="9,9"/><Button x:Name="MaintenanceActivity" Grid.Column="4" Content="Activity ↗" Background="Transparent" Foreground="#147C71" FontSize="11" Padding="9,9"/></Grid>
      </StackPanel>
    </Border>
  </Grid></Grid>
</Window>
