<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Office Studio 1.2.2" Width="1160" Height="880" MinWidth="990" MinHeight="730" WindowStartupLocation="CenterScreen" Background="#F3F5F9" FontFamily="Segoe UI" Foreground="#182338">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#67758A"/>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="17,10"/><Setter Property="Background" Value="#E9EDF4"/><Setter Property="Foreground" Value="#27364D"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.84"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Profile" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Card" Background="#FFFFFF" BorderBrush="#DFE5EE" BorderThickness="1" CornerRadius="10" Padding="14,12"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#147C71"/><Setter TargetName="Card" Property="Background" Value="#EAF7F3"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#147C71"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Card" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AppTile" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,10,9"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Card" BorderThickness="1" BorderBrush="#E1E6EE" Background="White" CornerRadius="9" Padding="12,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="23"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center"/><Border x:Name="TickBox" Grid.Column="1" BorderThickness="1" BorderBrush="#BBC7D5" CornerRadius="4" Width="19" Height="19"><TextBlock x:Name="Tick" Text="&#x2713;" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Border></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#6AA89F"/><Setter TargetName="Card" Property="Background" Value="#F3FAF7"/><Setter TargetName="TickBox" Property="Background" Value="#147C71"/><Setter TargetName="TickBox" Property="BorderBrush" Value="#147C71"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#6AA89F"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Card" Property="Opacity" Value="0.36"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="9,7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  </Window.Resources>
  <Grid Background="#F3F5F9">
    <Grid.ColumnDefinitions><ColumnDefinition Width="222"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="#122A31">
      <Grid Margin="23,28,23,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal"><Border Width="38" Height="38" Background="#7DE2BB" CornerRadius="11"><TextBlock Text="K" FontSize="24" FontWeight="Bold" Foreground="#122A31" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="KAREER" Foreground="White" FontWeight="Bold" FontSize="20" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
          <TextBlock Text="OFFICE STUDIO" Foreground="#8FADB1" FontSize="10" FontWeight="SemiBold" Margin="49,3,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,54,0,0">
          <TextBlock Text="A simpler setup." FontSize="25" FontWeight="SemiBold" Foreground="White"/>
          <TextBlock Text="The Office you need.&#x0a;The apps you choose." FontSize="13" LineHeight="22" Foreground="#A6BBC0" Margin="0,12,0,34"/>
          <TextBlock x:Name="StepChoose" Text="01    Choose your Office" Foreground="#7DE2BB" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,24"/>
          <TextBlock x:Name="StepDownload" Text="02    Download your apps" Foreground="#A6BBC0" FontSize="13" Margin="0,0,0,24"/>
          <TextBlock x:Name="StepInstall" Text="03    Install when ready" Foreground="#A6BBC0" FontSize="13"/>
          <Border Background="#1B3840" CornerRadius="10" Padding="14" Margin="0,38,0,0"><StackPanel><TextBlock Text="OFFICE ON THIS PC" FontSize="10" FontWeight="Bold" Foreground="#7DE2BB"/><TextBlock x:Name="ComputerOfficeSummary" Text="Checking installed Office…" TextWrapping="Wrap" MaxHeight="54" FontSize="12" LineHeight="18" Foreground="#C1D1D4" Margin="0,8,0,0"/><Button x:Name="ManageOfficeButton" Content="Review &amp; uninstall  →" Background="#294B52" Foreground="White" FontSize="10" Padding="8,8" Margin="0,12,0,0"/></StackPanel></Border>
        </StackPanel>
        <StackPanel Grid.Row="3"><Border Height="1" Background="#335057" Margin="0,0,0,18"/><TextBlock Text="Created and provided by" FontSize="11" Foreground="#A6BBC0"/><TextBlock Text="KAREER" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/><TextBlock Text="Office Studio 1.2.2" FontSize="10" Foreground="#718F95" Margin="0,15,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="30,26,30,22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Your Office. Your way." FontSize="29" FontWeight="Bold"/><TextBlock Text="Choose an edition, pick your apps, and let us handle setup." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0"/></StackPanel><Border Grid.Column="1" Background="White" CornerRadius="12" Padding="12,7" VerticalAlignment="Top" Margin="12,7,0,0"><TextBlock Text="WINDOWS DESKTOP" FontSize="10" FontWeight="Bold" Foreground="#147C71"/></Border></Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
        <StackPanel x:Name="OptionsPanel">
          <TextBlock Text="01  /  Choose your edition" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,11"/>
          <UniformGrid Columns="4" x:Name="ProfilePanel">
            <RadioButton x:Name="Profile2019" GroupName="Edition" Style="{StaticResource Profile}" IsChecked="True"><StackPanel><TextBlock Text="Office 2019" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Professional Plus" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></RadioButton>
            <RadioButton x:Name="Profile2021" GroupName="Edition" Style="{StaticResource Profile}"><StackPanel><TextBlock Text="Office 2021" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="LTSC · Volume" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></RadioButton>
            <RadioButton x:Name="Profile2024" GroupName="Edition" Style="{StaticResource Profile}"><StackPanel><TextBlock Text="Office 2024" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="LTSC · Volume" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></RadioButton>
            <RadioButton x:Name="Profile365" GroupName="Edition" Style="{StaticResource Profile}" Margin="0"><StackPanel><TextBlock Text="Microsoft 365" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Apps · Subscription" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></RadioButton>
          </UniformGrid>
          <TextBlock x:Name="EditionNote" Foreground="#7E6950" FontSize="11" TextWrapping="Wrap" Margin="1,9,0,19"/>
          <Grid Margin="0,0,0,10"><TextBlock Text="02  /  Pick your apps" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="SelectAllButton" Content="Select all" Padding="10,5" Background="Transparent" Foreground="#147C71" FontSize="12"/><Button x:Name="ClearButton" Content="Clear" Padding="10,5" Background="Transparent" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></Grid>
          <UniformGrid x:Name="AppsPanel" Columns="3"/>
          <TextBlock Text="OneDrive and Teams are separate Microsoft installers. Publisher availability varies by edition." FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>
          <Border Background="White" CornerRadius="10" Padding="16,12" BorderBrush="#E2E7EF" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.65*"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="LANGUAGE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><ComboBox x:Name="LanguageCombo"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="ARCHITECTURE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><ComboBox x:Name="ArchitectureCombo"/></StackPanel>
              <StackPanel Grid.Column="4"><TextBlock Text="DOWNLOAD FOLDER" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FolderBox" IsReadOnly="True" Background="#F6F8FB" BorderThickness="0" Padding="9,8" FontSize="10" VerticalContentAlignment="Center"/><Button x:Name="BrowseButton" Grid.Column="1" Content="Browse" Margin="7,0,0,0" Padding="10,8" FontSize="11"/></Grid></StackPanel>
            </Grid>
          </Border>
          <TextBlock Text="Keep several GB free. Office downloads shared files even when you select only a few apps." FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="1,9,0,15"/>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Background="White" BorderBrush="#DDE5ED" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,12,0,0">
        <StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusTitle" Text="Ready to download" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="ProgressLabel" Grid.Column="1" Foreground="#147C71" FontSize="11" VerticalAlignment="Center"/></Grid>
          <TextBlock x:Name="StatusDetail" Text="Word + Excel · Office 2019" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" MaxHeight="34" Margin="0,6,0,9"/>
          <TextBlock x:Name="SavedSize" Text="Existing files: 0.0 MB on disk" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,7" ToolTip="File sizes may include reserved space. Microsoft checks which files can be reused."/><ProgressBar x:Name="ProgressBar" Height="5" BorderThickness="0" Background="#E9EEF3" Foreground="#168575" Minimum="0" Maximum="100"/>
          <CheckBox x:Name="LicenseCheck" FontSize="11" Foreground="#58677B" Margin="0,11,0,9"><TextBlock TextWrapping="Wrap"><Run Text="I have a valid Office license and accept "/><Hyperlink x:Name="LicenseTerms" NavigateUri="https://www.microsoft.com/en-us/useterms" Foreground="#147C71">Microsoft's license terms</Hyperlink><Run Text="."/></TextBlock></CheckBox>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="DownloadButton" Content="Download" Background="#147C71" Foreground="White" MinWidth="152"/><Button x:Name="InstallButton" Grid.Column="1" Content="Install Office" Background="#172F39" Foreground="White" MinWidth="141" IsEnabled="False" Margin="9,0,0,0"/><Button x:Name="AbortButton" Grid.Column="2" Content="Abort download" Visibility="Collapsed" Background="#FCE9E7" Foreground="#A5372A" Margin="9,0,0,0" Padding="12,10" HorizontalAlignment="Left"/><StackPanel Grid.Column="3" Orientation="Horizontal"><Button x:Name="OpenFolderButton" Content="Files" Background="Transparent" Padding="10,10" FontSize="11" Foreground="{StaticResource Muted}"/><Button x:Name="LogsButton" Content="Activity ↗" Background="Transparent" Padding="10,10" FontSize="11" Foreground="#147C71"/></StackPanel></Grid>
          <TextBlock Text="Save your work and close Office apps before installing. Setup may update an existing Office installation." Foreground="#8290A2" FontSize="9" TextWrapping="Wrap" Margin="0,9,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
